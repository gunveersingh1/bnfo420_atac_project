`# ================================
# Load Required Libraries
# ================================
library(Seurat)
library(Signac)
library(GenomicRanges)
library(ChIPseeker)
library(dplyr)
library(ggplot2)
library(TxDb.Hsapiens.UCSC.hg38.knownGene)
library(org.Hs.eg.db)
# ================================
# Load Multiome Object
# ================================
obj <- readRDS("GSE296875_allwells_RNA-ATAC-jointpass-UMI1000-harmonized_WNN_azimuth.rds")
# Set ATAC assay
DefaultAssay(obj) <- "ATAC"
# Inspect metadata
head(obj@meta.data)
table(Idents(obj))
Idents(obj) <- obj$celltype
# ================================
# Differential Accessibility
# ================================
da_peaks <- FindMarkers(
object = obj,
ident.1 = "Liver",
test.use = "LR",
latent.vars = "nCount_ATAC"
)
# Filter significant peaks
liver_specific_peaks <- da_peaks %>%
filter(p_val_adj < 0.05 & avg_log2FC > 0.25)
# Save results
write.csv(liver_specific_peaks,
"liver_specific_peaks.csv",
row.names = TRUE)
# ================================
# Extract Peak Coordinates
# ================================
peak_ranges <- granges(obj)
liver_peak_gr <- peak_ranges[rownames(liver_specific_peaks)]
# ================================
# Peak Annotation
# ================================
peak_annotation <- annotatePeak(
liver_peak_gr,
TxDb = TxDb.Hsapiens.UCSC.hg38.knownGene,
annoDb = "org.Hs.eg.db"
)
annotated_df <- as.data.frame(peak_annotation)
write.csv(annotated_df,
"liver_peak_annotations.csv",
row.names = FALSE)
genes <- read.csv("cardiometabolic_gene_list.csv")
# ================================
# Enrichment Test
# ================================
# Liver overlap
liver_overlap <- sum(annotated_df$SYMBOL %in% genes$GeneSymbol)
# Background peaks
background_annotation <- annotatePeak(
peak_ranges,
TxDb = TxDb.Hsapiens.UCSC.hg38.knownGene,
annoDb = "org.Hs.eg.db"
)
background_df <- as.data.frame(background_annotation)
background_overlap <- sum(background_df$SYMBOL %in% genes$GeneSymbol)
# Build contingency table
enrichment_matrix <- matrix(
c(liver_overlap,
nrow(annotated_df) - liver_overlap,
background_overlap,
nrow(background_df) - background_overlap),
nrow = 2
)
# Fisher's exact test
fisher_result <- fisher.test(enrichment_matrix)
print(fisher_result)
bar_data <- data.frame(
Category = c("Liver Peaks", "Background Peaks"),
Overlap = c(liver_overlap, background_overlap)
)
ggplot(bar_data, aes(x = Category, y = Overlap)) +
geom_bar(stat = "identity") +
theme_minimal() +
ggtitle("Cardiometabolic Gene Overlap")
